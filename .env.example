# Supabase (opcional). Sem estas chaves o jogo salva só neste aparelho.
# URL do projeto, sem /rest/v1. Ex.: https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Sign-In. O login com Google exige um development build (não funciona no Expo Go).
# Crie um OAuth Client ID (Web) no Google Cloud e cole aqui.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS: cole o URL scheme invertido também em app.json (plugin @react-native-google-signin/google-signin).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Anúncios. Deixe desligado até ter IDs reais do AdMob.
# IDs de teste oficiais do Google (não usar em produção):
# Android App: ca-app-pub-3940256099942544~3347511947
# iOS App:     ca-app-pub-3940256099942544~3347511947
# Banner:      ca-app-pub-3940256099942544/3347511947
# Interstitial:ca-app-pub-3940256099942544/3347511947
# Rewarded:    ca-app-pub-3940256099942544/3347511947
EXPO_PUBLIC_ADS_ENABLED=false
EXPO_PUBLIC_ADMOB_BANNER_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=
EXPO_PUBLIC_ADMOB_REWARDED_ID=
